# ============================================
# Cognify Platform Environment Configuration
# ============================================
# Copy this file to .env or .env.local and update values as needed.
# DO NOT commit .env or .env.local to version control!

# --------------------------------------------
# Database Configuration (MySQL - StackCP)
# --------------------------------------------
DB_HOST=your-mysql-host
DB_USER=your_db_user
DB_PASSWORD=your_password_here
DB_NAME=your_db_name
DB_PORT=43119

# --------------------------------------------
# API Server Configuration
# --------------------------------------------
API_PORT=3001
NODE_ENV=development

# --------------------------------------------
# LLM Configuration (Primary AI Backend)
# --------------------------------------------
# The backend LLM server URL (Ollama/vLLM). Used for:
# - Non-streaming: /llm-api endpoint → ${LLAMA_API_URL}
# - Streaming: derived from LLAMA_API_URL by replacing /api/chat with /api/generate
LLAMA_API_URL=http://localhost:11434/api/chat

# Model name to use (primary)
LLAMA_MODEL=kimi-k2.5:cloud

# Optional API key if your LLM server requires auth
LLAMA_API_KEY=

# --------------------------------------------
# OpenRouter Configuration (Fallback LLM)
# --------------------------------------------
# Get your API key from https://openrouter.ai
# Used as fallback when primary LLM fails
# Secrets must NOT use the VITE_ prefix — that bundles them into the browser.
# Set LLM_API_KEY below instead (leave empty for keyless local providers).

# Fallback models (comma-separated). Tried in order if primary fails.
# Example models: arcee-ai/trinity-large-preview:free, openai/gpt-5-nano, google/gemini-2.0-flash-preview-0514
VITE_LLM_MODELS=arcee-ai/trinity-large-preview:free,openai/gpt-5-nano,google/gemini-2.0-flash-preview-0514

# --------------------------------------------
# Exa Search API (Web Search for Chatbot)
# --------------------------------------------
# Get your API key from https://dashboard.exa.ai/
# Enables web search for accurate, up-to-date information in chatbot
# Only needed when SEARCH_PROVIDER=exa; the default (searxng) needs no key.
EXA_API_KEY=

# --------------------------------------------
# ChromaDB Vector Service (RAG)
# --------------------------------------------
# Google API key for generating embeddings (text-embedding-004)
# Get from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_genai_api_key_here

# Vector service URL (Python FastAPI service for ChromaDB)
VECTOR_SERVICE_URL=http://localhost:8000

# Piston Code Execution (self-hosted)
PISTON_URL=http://localhost:2000   # bound to 127.0.0.1 only; never expose publicly
EXEC_RATE_LIMIT_PER_MIN=20

# Allowed browser origins in production (comma separated)
CORS_ORIGINS=https://cognify.ourspaces.net

# Web search provider: "searxng" (self-hosted, free) or "exa" (hosted, needs EXA_API_KEY)
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8888

# ── LLM provider ──
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty for providers that
# need no credentials (e.g. a local Ollama on this host).
#   OmniRoute:     LLM_BASE_URL=http://127.0.0.1:20128/v1  (no key; gateway)
#   Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1   (no key; direct)
#   OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1 (key required)
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_MODELS=gemma4:31b-cloud,kimi-k2.5:cloud
LLM_API_KEY=

# ── Authentication ──
# Signs Cognify session tokens (min 32 chars). Generate: openssl rand -base64 48
# Rotating it signs every user out.
SESSION_SECRET=
# Google OAuth client id(s) that sign-in tokens must be issued to (comma-separated).
# Must match the clientId in index.tsx.
GOOGLE_CLIENT_ID=
# Session lifetime in seconds (default 7 days).
# SESSION_TTL_SECONDS=604800
# RAG retrieval is scoped to each user's own documents. Set true only if every
# user's uploads should be searchable by everyone.
# RAG_SHARED_KNOWLEDGE=false
# Optional endpoint tried when LLM_BASE_URL is unreachable (e.g. Ollama directly
# behind an OmniRoute primary), so one outage does not take down every AI feature.
# LLM_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1

# Interface the API binds to. Keep loopback: nginx is the only intended client.
# API_HOST=127.0.0.1
