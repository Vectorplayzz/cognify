{
  "name": "CognifyAi-learning-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n FE,BE -c cyan,yellow \"vite\" \"node server/index.js\"",
    "dev:fe": "vite",
    "dev:be": "node server/index.js",
    "dev:be:debug": "node --inspect server/index.js",
    "test:db": "node server/diagnostics.js",
    "db:check": "node server/db-check.js",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build --config vite.config.prod.ts",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test server/tests/*.test.js",
    "test:integration": "node --test server/tests/integration/"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@google/genai": "^1.40.0",
    "@react-oauth/google": "^0.13.4",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.0",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.48.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
